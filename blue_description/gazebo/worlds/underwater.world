<?xml version="1.0"?>
<sdf version="1.10">
  <world name="underwater_world">
    <!-- Set initial position to Barcelona -->
    <spherical_coordinates>
      <!-- Use WGS84 for standard GPS coordinates -->
      <surface_model>EARTH_WGS84</surface_model>
      <!-- Zurich coordinates -->
      <latitude_deg>41.318319</latitude_deg>
      <longitude_deg>2.171525</longitude_deg>
      <!-- Altitude in meters above sea level -->
      <elevation>0.0</elevation>
      <!-- Heading offset (rotation between Gazebo X-axis and East) -->
      <heading_deg>85.0</heading_deg>
    </spherical_coordinates>

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <physics name="default_physics" type="dart">
      <max_step_size>0.004</max_step_size>
      <real_time_update_rate>125</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- Add the sensor plugins for gazebo integration-->
    <plugin
      filename="libgz-sim8-dvl-system"
      name="gz::sim::systems::DopplerVelocityLogSystem">
    </plugin>
    
    <plugin filename="libgz-sim-imu-system.so"
      name="gz::sim::systems::Imu">
    </plugin>

    <plugin
      filename="gz-sim-buoyancy-system"
      name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1</density>
        </density_change>
      </graded_buoyancy>
    </plugin>

    <!-- <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include> -->

    <include>
      <uri>model://sand_heightmap</uri>
      <pose>0 7 -10.5 0 0 0</pose>
      <static>true</static>
    </include>

    <include>
    <uri>model://harbor</uri>
    <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- <include>
    <uri>model://apriltags</uri>
    <pose>0 0 0 0 0 0</pose>
    </include>
   
    <include>
    <uri>model://features</uri>
    <pose>0 0 0 0 0 0</pose>
    </include> -->
    

<scene>
  <ambient>0.2 0.3 0.35 1</ambient>
  <background>0.05 0.12 0.2 1</background>
  <fog>
    <color>0.03 0.1 0.18 1</color>
    <type>linear</type>
    <start>2.0</start>
    <end>30.0</end>
    <density>0.02</density>
  </fog>
</scene>

<light type="directional" name="sun1">
  <pose>0 0 10 0 0 0</pose>
  <diffuse>0.6 0.75 0.8 1</diffuse>
  <specular>0.1 0.15 0.2 1</specular>
  <direction>0.0 0.0 -1</direction>
  <cast_shadows>false</cast_shadows>
</light>

<light type="directional" name="sun2">
  <pose>5 5 8 0 0 0</pose>
  <diffuse>0.3 0.45 0.55 1</diffuse>
  <specular>0.0 0.0 0.0 1</specular>
  <direction>-0.2 -0.2 -1</direction>
  <cast_shadows>false</cast_shadows>
</light>
    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Coast Water
      </uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <scene>
      <ambient>1.0 1.0 1.0</ambient>
      <background>0.8 0.8 0.8</background>
      <sky></sky>
    </scene>

    <!-- <light type="directional" name="sun1">
      <pose>50 0 150 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>.1 .1 .1 1</specular>
      <direction>0.3 0.3 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light> -->

  </world>
</sdf>